# Copy to .env and fill in. Never commit .env.
CHANNEL_LANG=hi                     # hi (default) or en. LANG=hi|en also works; CHANNEL_LANG wins because shells set LANG=en_US.UTF-8
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=    # path to service-account JSON for Cloud TTS (Phase 3)
YOUTUBE_CLIENT_SECRETS=            # path to OAuth client JSON (Phase 5)
AMAZON_ASSOCIATES_TAG=             # Phase 4
AMAZON_PAAPI_ACCESS_KEY=           # stub provider only
AMAZON_PAAPI_SECRET_KEY=
FLIPKART_AFFILIATE_ID=             # Phase 4
FLIPKART_AFFILIATE_TOKEN=          # stub provider only
