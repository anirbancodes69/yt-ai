# Copy to .env and fill in. Never commit .env.
CHANNEL_LANG=hi                     # hi (default) or en. LANG=hi|en also works; CHANNEL_LANG wins because shells set LANG=en_US.UTF-8
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=    # service-account JSON for Cloud TTS, path as seen in the container, e.g. /app/secrets/gcp.json
YOUTUBE_CLIENT_SECRETS=            # path to OAuth client JSON (Phase 5)
AMAZON_ASSOCIATES_TAG=             # your Associates store ID, added to amazon links as ?tag=
AMAZON_PAAPI_ACCESS_KEY=           # stub provider only
AMAZON_PAAPI_SECRET_KEY=
FLIPKART_AFFILIATE_ID=             # added to flipkart links as ?affid=
FLIPKART_AFFILIATE_TOKEN=          # stub provider only
